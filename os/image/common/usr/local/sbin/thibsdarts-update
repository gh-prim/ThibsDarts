#!/bin/bash
# Mise a jour automatique de ThibsDarts depuis les releases GitHub.
#
# Les versions installees vivent dans /data/system/releases/<tag>, et /data/system/current
# pointe sur celle qui tourne (/opt/thibsdarts -> /data/system/current). Le systeme (rootfs)
# est en lecture seule et n'est jamais modifie.
#
# Usage : thibsdarts-update [--force]   (--force : ignore la partie en cours et la liste noire)
set -euo pipefail

# shellcheck source=/dev/null
. /etc/thibsdarts/thibsdarts.conf # ROLE, REPO, SERVICES, MQTT_HOST

SYS=/data/system
REL="$SYS/releases"
BAD="$SYS/bad-releases"
FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1

exec 9>/run/thibsdarts-update.lock
flock -n 9 || exit 0

log() { echo "thibsdarts-update: $*"; }

current_tag() { cat "$SYS/current/VERSION" 2>/dev/null || echo none; }

# Derniere release publiee (ni brouillon, ni pre-release) : on suit la redirection de /latest.
latest_tag() {
  local url
  url=$(curl -fsSL -o /dev/null -w '%{url_effective}' --max-time 20 "https://github.com/$REPO/releases/latest") || return 1
  case "$url" in */releases/tag/*) echo "${url##*/releases/tag/}" ;; *) return 1 ;; esac
}

# Le hub publie {"playing": true|false} en retenu sur thibsdarts/hub/state.
playing() {
  mosquitto_sub -h "$MQTT_HOST" -t thibsdarts/hub/state -C 1 -W 3 2>/dev/null | grep -Eq '"playing" *: *true'
}

switch_to() {
  ln -sfn "releases/$1" "$SYS/current.new"
  mv -T "$SYS/current.new" "$SYS/current"
  sync
}

restart_services() {
  # shellcheck disable=SC2086
  systemctl restart $SERVICES
}

# Sain = tous les services actifs et aucun redemarrage automatique pendant 30 s.
healthy() {
  local s before=() i=0
  for s in $SERVICES; do before+=("$(systemctl show -p NRestarts --value "$s")"); done
  sleep 30
  for s in $SERVICES; do
    systemctl is-active -q "$s" || return 1
    [ "$(systemctl show -p NRestarts --value "$s")" = "${before[$i]}" ] || return 1
    i=$((i + 1))
  done
}

# Garde la version courante et la precedente, supprime le reste.
prune() {
  local keep_cur keep_prev d
  keep_cur=$(readlink "$SYS/current" || true)
  keep_prev=$(readlink "$SYS/previous" 2>/dev/null || true)
  for d in "$REL"/*; do
    [ -d "$d" ] || continue
    case "releases/$(basename "$d")" in "$keep_cur" | "$keep_prev") ;; *) rm -rf "$d" ;; esac
  done
}

tag=$(latest_tag) || { log "GitHub injoignable"; exit 0; }
cur=$(current_tag)
[ "$tag" = "$cur" ] && exit 0

if [ $FORCE = 0 ] && grep -qxF "$tag" "$BAD" 2>/dev/null; then
  log "$tag deja refusee (ne demarrait pas), on reste en $cur"
  exit 0
fi
if [ $FORCE = 0 ] && playing; then
  log "$tag disponible, partie en cours : on attend"
  exit 0
fi

log "mise a jour $cur -> $tag"
asset="thibsdarts-$ROLE-$tag.tar.gz"
base="https://github.com/$REPO/releases/download/$tag"
tmp=$(mktemp -d "$SYS/tmp.XXXXXX") # sur /data : la RAM (overlay) est trop petite
trap 'rm -rf "$tmp"' EXIT

if ! curl -fsSL --retry 3 --max-time 600 -o "$tmp/$asset" "$base/$asset" ||
  ! curl -fsSL --retry 3 --max-time 60 -o "$tmp/SHA256SUMS" "$base/SHA256SUMS"; then
  log "fichiers de $tag pas encore publies, nouvel essai plus tard"
  exit 0
fi
awk -v a="$asset" '$2 == a' "$tmp/SHA256SUMS" >"$tmp/sum"
[ -s "$tmp/sum" ] && (cd "$tmp" && sha256sum -c --status sum) ||
  { log "somme SHA256 invalide pour $asset"; exit 1; }

mkdir "$tmp/x"
tar -xzf "$tmp/$asset" -C "$tmp/x"
chmod 755 "$tmp/x" # les paquets <= v0.2.2 ont une racine en 700 : le hub (thibs) ne pourrait pas y entrer
[ "$(cat "$tmp/x/VERSION" 2>/dev/null)" = "$tag" ] || { log "VERSION ne correspond pas a $tag"; exit 1; }
rm -rf "${REL:?}/$tag"
mv "$tmp/x" "$REL/$tag"

prev=$(readlink "$SYS/current" || true)
switch_to "$tag"
restart_services
if healthy; then
  [ -n "$prev" ] && ln -sfn "$prev" "$SYS/previous"
  prune
  log "ok, $tag installee"
  exit 0
fi

log "$tag ne demarre pas, retour a $cur"
echo "$tag" >>"$BAD"
if [ -n "$prev" ]; then
  ln -sfn "$prev" "$SYS/current.new" && mv -T "$SYS/current.new" "$SYS/current" && sync
fi
restart_services
exit 1
