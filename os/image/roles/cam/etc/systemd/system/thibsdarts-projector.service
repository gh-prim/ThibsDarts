[Unit]
Description=ThibsDarts vidéoprojecteur (page projetée et calibration, port 8082)
After=network-online.target
RequiresMountsFor=/data
Wants=network-online.target

[Service]
User=thibs
Group=thibs
Environment=MQTT_HOST=dartos-hub.local
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/thibsdarts/cam/projector
ExecStart=/usr/bin/python3 server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
