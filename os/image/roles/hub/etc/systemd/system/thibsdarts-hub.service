[Unit]
Description=ThibsDarts hub (flutter-pi)
After=systemd-user-sessions.service network-online.target plymouth-start.service
RequiresMountsFor=/data
Wants=network-online.target

[Service]
User=thibs
Group=thibs
SupplementaryGroups=video render input
Environment=DARTOS_DATA=/data/thibsdarts
# Dalle 7" 1024x600 (CX070) : pixels environ 5 % plus larges que hauts.
Environment=DARTOS_PIXEL_ASPECT=1.052
WorkingDirectory=/opt/thibsdarts/hub
# Plymouth lache l'ecran mais laisse la tete de Thibs affichee jusqu'a la premiere image de l'app.
ExecStartPre=-+/usr/bin/plymouth quit --retain-splash
ExecStart=/opt/thibsdarts/hub/flutter-pi --release /opt/thibsdarts/hub
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
