[Unit]
Description=ThibsDarts vidéoprojecteur : page projetée en plein écran sur la sortie HDMI (cage + Chromium)
After=systemd-user-sessions.service thibsdarts-vision.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty1

[Service]
User=thibs
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=WLR_LIBINPUT_NO_DEVICES=1
# Curseur invisible : cage dessine sinon une flèche au milieu de l'image projetée.
Environment=XCURSOR_PATH=/opt/thibsdarts/cam/projector/cursor:/opt/thibsdarts-cam/projector/cursor XCURSOR_THEME=default
ExecStartPre=/bin/bash -c 'until (exec 3<>/dev/tcp/127.0.0.1/8082) 2>/dev/null; do sleep 1; done'
# Le vidéoprojecteur annonce 1280x800 mais n'affiche rien dans ce mode : chaque sortie passe en
# KIOSK_MODE avant Chromium (sans wlr-randr ou sans ce mode, on garde celui par défaut).
Environment=KIOSK_MODE=1280x720@60Hz
ExecStart=/usr/bin/cage -d -- /bin/sh -c 'for o in $$(wlr-randr 2>/dev/null | grep -o "^[^ ]*"); do \
  wlr-randr --output $$o --mode $$KIOSK_MODE || true; done; \
  exec /usr/bin/chromium --kiosk --noerrdialogs --disable-infobars --no-first-run \
  --disable-session-crashed-bubble --disable-features=Translate,TranslateUI --lang=fr --accept-lang=fr --password-store=basic \
  --check-for-update-interval=31536000 --ozone-platform=wayland --user-data-dir=/tmp/thibsdarts-kiosk \
  http://127.0.0.1:8082/'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
