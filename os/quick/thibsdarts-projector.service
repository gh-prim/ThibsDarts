[Unit]
Description=ThibsDarts vidéoprojecteur (page projetée et calibration, port 8082)
After=network-online.target
Wants=network-online.target

[Service]
User=thibs
Group=thibs
Environment=MQTT_HOST=192.168.1.239
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/thibsdarts-cam/projector
ExecStart=/usr/bin/python3 server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
