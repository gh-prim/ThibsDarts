[Unit]
Description=ThibsDarts caméras (aperçu MJPEG port 8081, statut MQTT)
After=network-online.target
Wants=network-online.target

[Service]
User=thibs
Group=thibs
SupplementaryGroups=video
Environment=MQTT_HOST=192.168.1.239
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/thibsdarts-cam/vision
ExecStart=/usr/bin/python3 server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
